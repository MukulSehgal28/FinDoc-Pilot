# FinDoc-Pilot environment configuration (template)
#
# Copy this file to `.env` and fill in your real values:
#   Copy-Item .env.example .env      (PowerShell)
#   cp .env.example .env             (bash)
#
# `.env` is git-ignored and must never be committed.
# Replace every placeholder below with your own values.

# PostgreSQL connection string (required by /health/db).
# Shape: postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
# URL-encode special characters in the password (@ : / # ? % become %40 %3A etc.).
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME
